<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/white"
    app:contentPadding="10dp"
    app:contentPaddingLeft="15dp"
    android:layout_marginVertical="5dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="15dp"
            android:contentDescription="@string/profile_icon"
            app:srcCompat="@drawable/profile_icon"
            app:shapeAppearanceOverlay="@style/CircleImageViewStyle"
            tools:ignore="RtlHardcoded" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="20sp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/childName"
                tools:text="Child Name"
                android:textColor="@color/element_font"
                android:fontFamily="@font/frutiger_bold"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/childAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="N years old"
                android:layout_marginBottom="2sp"
                android:textSize="13sp"
                android:textColor="@color/darkgray"
                android:fontFamily="@font/frutiger_light"/>
            <TextView
                android:id="@+id/lastAssessment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5sp"
                android:text="@string/last_assessment_format"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="@color/darkgray"
                android:fontFamily="@font/frutiger_light"
                app:drawableStartCompat="@drawable/outline_calendar_clock_16" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>