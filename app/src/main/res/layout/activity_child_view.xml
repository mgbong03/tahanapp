<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".activity.ChildViewActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <include layout="@layout/toolbar_center_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profileImage"
                    android:layout_width="100dp"
                    android:layout_height="105dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/profile_icon"
                    app:shapeAppearanceOverlay="@style/CircleImageViewStyle"
                    app:srcCompat="@drawable/profile_icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/childName"
                    tools:text="Child Name"
                    android:textColor="@color/element_font"
                    android:fontFamily="@font/frutiger_bold"
                    android:layout_marginHorizontal="20dp"
                    android:textAlignment="center"
                    android:textSize="20sp"/>
                <TextView
                    android:id="@+id/childAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="N years old"
                    android:textAlignment="center"
                    android:textColor="@color/darkgray"
                    android:fontFamily="@font/frutiger_light"/>
                <TextView
                    android:id="@+id/childGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Gender: Gender"
                    android:textAlignment="center"
                    android:textColor="@color/darkgray"
                    android:fontFamily="@font/frutiger_light"/>
                <TextView
                    android:id="@+id/childDiagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Diagnosis: Insert Diagnosis Here"
                    android:textAlignment="center"
                    android:textColor="@color/darkgray"
                    android:fontFamily="@font/frutiger_light"/>
            </LinearLayout>
            <Button
                android:id="@+id/startAssessmentBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_start_tint"
                android:fontFamily="@font/frutiger_bold"
                android:textColor="@color/white"
                android:text="@string/start_new_assessment"
                />
            <Button
                android:id="@+id/editProfileBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_tint"
                android:fontFamily="@font/frutiger_bold"
                android:textColor="@color/white"
                android:text="@string/edit_profile"
                />
            <Button
                android:id="@+id/deleteProfileBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/element_font_danger"
                android:fontFamily="@font/frutiger_bold"
                android:textColor="@color/white"
                android:text="@string/delete_profile"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-5dp"
                android:layout_marginEnd="-5dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:id="@+id/historyBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    app:contentPadding="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/history"
                            app:srcCompat="@drawable/history_icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:textColor="@color/element_font"
                            android:textSize="14sp"
                            android:text="@string/history" />
                        <TextView
                            android:id="@+id/historyCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_light"
                            android:textColor="@color/gray"
                            android:textSize="12sp"
                            tools:text="N assessments" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/faqsBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    app:contentPadding="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/faq"
                            app:srcCompat="@drawable/faqs_icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:textColor="@color/element_font"
                            android:textSize="14sp"
                            android:text="@string/faq" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:fontFamily="@font/frutiger_bold"
                android:textColor="@color/element_font"
                android:layout_marginBottom="5dp"
                android:text="@string/latest_assessment" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/latestAssessments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/card_assessment" />
            <LinearLayout
                android:id="@+id/noAssessmentsFound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/layout_bg"
                android:backgroundTint="@color/sublayout_tint"
                android:foregroundTint="@color/sublayout_tint"
                android:backgroundTintMode="multiply"
                android:foregroundTintMode="multiply"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:paddingHorizontal="50dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="5dp"
                    app:srcCompat="@drawable/clipboard" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/frutiger_bold"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="5dp"
                    android:text="@string/no_assessments"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="@font/frutiger_light"
                    android:textColor="@color/gray"
                    android:textAlignment="center"
                    android:layout_marginBottom="5dp"
                    android:text="@string/prompt_start_assessment"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>