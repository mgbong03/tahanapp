<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".activity.AsdActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <include layout="@layout/toolbar_center_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">
            <LinearLayout
                android:id="@+id/asdModule1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger_bold"
                    android:textSize="16sp"
                    android:text="@string/learning_hub_module_5"
                    android:textColor="@color/element_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s1"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s1_d1"
                    android:textColor="@color/darkgray" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s2"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s2_d1"
                    android:layout_marginBottom="5sp"
                    android:textColor="@color/darkgray" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s2_d2"
                    android:layout_marginBottom="10sp"
                    android:textColor="@color/darkgray" />
                <LinearLayout
                    android:id="@+id/autismPh_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/sublayout_tint"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="@string/lhub_m5_s2_d1"
                        app:srcCompat="@drawable/call_icon"
                        tools:ignore="RtlHardcoded" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:text="@string/lhub_m5_s2_d3"
                            android:textColor="@color/element_font"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger"
                            android:text="@string/lhub_m5_s2_d3_data"
                            android:textColor="@color/darkgray" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/autismPh_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/sublayout_tint"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="@string/lhub_m5_s2_d1"
                        app:srcCompat="@drawable/baseline_mail_outline_24"
                        tools:ignore="RtlHardcoded" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:text="@string/lhub_m5_s2_d4"
                            android:textColor="@color/element_font"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger"
                            android:text="@string/lhub_m5_s2_d4_data"
                            android:textColor="@color/darkgray" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/autismPh_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/sublayout_tint"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="@string/lhub_m5_s2_d1"
                        app:srcCompat="@drawable/internet"
                        tools:ignore="RtlHardcoded" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:text="@string/lhub_m5_s2_d5"
                            android:textColor="@color/element_font"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger"
                            android:text="@string/lhub_m5_s2_d5_data"
                            android:textColor="@color/darkgray" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s3"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s3_d1"
                    android:layout_marginBottom="20sp"
                    android:textColor="@color/darkgray" />
                <TextView
                    android:id="@+id/secondaryAspLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s3_d2"
                    android:layout_marginBottom="5sp"
                    android:textColor="@color/element_font" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s3_d3"
                    android:layout_marginBottom="15sp"
                    android:textColor="@color/darkgray" />
                <TextView
                    android:id="@+id/secondaryAPinoyLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s3_d4"
                    android:layout_marginBottom="5sp"
                    android:textColor="@color/element_font" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s3_d5"
                    android:textColor="@color/darkgray" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s4"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s4_d1"
                    android:layout_marginBottom="10sp"
                    android:textColor="@color/darkgray" />
                <LinearLayout
                    android:id="@+id/fb_link_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/sublayout_tint"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="@string/lhub_m5_s4"
                        app:srcCompat="@drawable/facebook"
                        tools:ignore="RtlHardcoded" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:text="@string/lhub_m5_s4_d2"
                            android:textColor="@color/element_font"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger"
                            android:text="@string/lhub_m5_s4_d2_uri"
                            android:textSize="12sp"
                            android:textColor="@color/darkgray" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/fb_link_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/sublayout_tint"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="@string/lhub_m5_s4"
                        app:srcCompat="@drawable/facebook"
                        tools:ignore="RtlHardcoded" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger_bold"
                            android:text="@string/lhub_m5_s4_d3"
                            android:textColor="@color/element_font"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/frutiger"
                            android:text="@string/lhub_m5_s4_d3_uri"
                            android:textSize="12sp"
                            android:textColor="@color/darkgray" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/warning_tint"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5sp"
                        android:fontFamily="@font/frutiger_bold"
                        android:text="@string/lhub_m5_s4_d4"
                        android:textColor="@color/element_font_warning"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/frutiger"
                        android:text="@string/lhub_m5_s4_d5"
                        android:textColor="@color/element_font_warning" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s5"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s5_d1"
                    android:textColor="@color/darkgray" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5sp"
                    android:fontFamily="@font/frutiger_bold"
                    android:text="@string/lhub_m5_s6"
                    android:textColor="@color/element_font"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/frutiger"
                    android:text="@string/lhub_m5_s6_d1"
                    android:textColor="@color/darkgray" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>