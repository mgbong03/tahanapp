<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/white"
    app:contentPadding="10dp"
    app:contentPaddingLeft="15dp"
    app:contentPaddingRight="15dp"
    android:layout_marginVertical="5dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="20sp"
            android:orientation="vertical"
            tools:ignore="RtlSymmetry">
            <TextView
                android:id="@+id/assessmentDate"
                android:layout_marginBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="January 1, 1970 - 08:00 AM"
                android:textColor="@color/darkgray"
                android:fontFamily="@font/frutiger_light"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/assessmentLevelColor"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginVertical="3dp"
                    android:background="@drawable/layout_bg"
                    android:backgroundTint="@color/gray"/>
                <TextView
                    android:id="@+id/assessmentLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    tools:text="Pain Level"
                    android:textSize="24sp"
                    android:textColor="@color/element_font"
                    android:fontFamily="@font/frutiger_bold"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/assessmentScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/element_font"
            android:fontFamily="@font/frutiger"
            tools:text="3 / 10" />
    </LinearLayout>
</androidx.cardview.widget.CardView>